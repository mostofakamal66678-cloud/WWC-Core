/* ================================
   WWC HOME — TIKTOK STYLE UI
================================ */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #000;
  color: #fff;
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif;
}

body {
  overscroll-behavior: none;
  -webkit-user-select: none;
  user-select: none;
}

button {
  border: 0;
  outline: 0;
  cursor: pointer;
  background: transparent;
  color: inherit;
  font-family: inherit;
}

/* ================================
   MAIN APP
================================ */

.app {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100dvh;
  background: #000;
  overflow: hidden;
}

/* ================================
   VIDEO FEED
================================ */

.feed {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100dvh;

  overflow-y: auto;
  overflow-x: hidden;

  scroll-snap-type: y mandatory;
  scroll-behavior: smooth;

  background: #000;

  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.feed::-webkit-scrollbar {
  display: none;
}

/* ================================
   VIDEO ITEM
================================ */

.video-item {
  position: relative;

  width: 100%;
  height: 100dvh;

  overflow: hidden;

  background: #000;

  scroll-snap-align: start;
  scroll-snap-stop: always;
}

/* ================================
   VIDEO
================================ */

.video {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  background: #000;

  z-index: 1;
}

/* Slight dark gradient for readability */
.video-item::after {
  content: "";

  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;

  height: 42%;

  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.78),
    rgba(0, 0, 0, 0.25),
    transparent
  );

  pointer-events: none;

  z-index: 2;
}

/* ================================
   VIDEO LOADER
================================ */

.video-loader {
  position: absolute;

  top: 50%;
  left: 50%;

  width: 42px;
  height: 42px;

  transform: translate(-50%, -50%);

  display: flex;
  align-items: center;
  justify-content: center;

  z-index: 8;
}

.video-loader span {
  width: 35px;
  height: 35px;

  border: 3px solid rgba(255, 255, 255, 0.25);
  border-top-color: #fff;

  border-radius: 50%;

  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ================================
   TOP BAR
================================ */

.top-bar {
  position: absolute;

  top: 0;
  left: 0;
  right: 0;

  height: 108px;

  padding-top: 42px;
  padding-left: 18px;
  padding-right: 18px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.55),
    rgba(0, 0, 0, 0)
  );

  z-index: 20;
}

/* ================================
   TABS
================================ */

.tabs {
  display: flex;
  align-items: center;
  gap: 20px;

  margin: 0 auto;
}

.tab {
  position: relative;

  padding: 9px 15px;

  color: rgba(255, 255, 255, 0.55);

  font-size: 16px;
  font-weight: 600;

  border-radius: 20px;

  transition: 0.2s ease;
}

.tab.active {
  color: #fff;

  background: rgba(255, 255, 255, 0.18);

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

/* ================================
   SEARCH
================================ */

.search-btn {
  position: absolute;

  right: 18px;
  top: 48px;

  width: 40px;
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #fff;

  font-size: 20px;

  border-radius: 50%;

  background: rgba(0, 0, 0, 0.28);
}

.search-btn:active {
  transform: scale(0.9);
}

/* ================================
   ACTION BAR
================================ */

.action-bar {
  position: absolute;

  right: 12px;
  bottom: 145px;

  width: 62px;

  display: flex;
  flex-direction: column;
  align-items: center;

  gap: 20px;

  z-index: 15;
}

/* ================================
   ACTION BUTTON
================================ */

.action {
  position: relative;

  width: 56px;

  display: flex;
  flex-direction: column;
  align-items: center;

  color: #fff;
}

.action-icon {
  width: 50px;
  height: 50px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 29px;

  text-shadow:
    0 2px 5px rgba(0, 0, 0, 0.6),
    0 1px 2px rgba(0, 0, 0, 0.8);
}

.action-count {
  margin-top: 2px;

  font-size: 14px;
  font-weight: 600;

  color: #fff;

  text-shadow: 0 1px 4px #000;
}

/* ================================
   LIKE
================================ */

.like-btn.liked {
  color: #ff2d55;
}

.like-btn.liked .action-icon {
  animation: likePop 0.25s ease;
}

@keyframes likePop {
  0% {
    transform: scale(0.7);
  }

  60% {
    transform: scale(1.25);
  }

  100% {
    transform: scale(1);
  }
}

/* ================================
   SAVE
================================ */

.save-btn.saved {
  color: #29b6f6;
}

.save-btn.saved .action-icon {
  color: #29b6f6;
}

/* ================================
   CREATOR AVATAR
================================ */

.creator-avatar {
  position: relative;

  width: 52px;
  height: 52px;

  margin-bottom: 3px;
}

.creator-avatar img {
  width: 52px;
  height: 52px;

  object-fit: cover;

  border-radius: 50%;

  border: 2px solid #fff;

  background: #222;
}

/* ================================
   FOLLOW PLUS
================================ */

.follow-plus {
  position: absolute;

  bottom: -8px;
  left: 50%;

  transform: translateX(-50%);

  width: 24px;
  height: 24px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #ff2d55;
  color: #fff;

  font-size: 17px;
  font-weight: 800;

  border: 2px solid #000;
}

.follow-plus.following {
  background: #fff;
  color: #111;
}

/* ================================
   SOUND BUTTON
================================ */

.sound-btn {
  position: absolute;

  right: 20px;
  bottom: 85px;

  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #fff;

  font-size: 19px;

  border-radius: 50%;

  background: rgba(0, 0, 0, 0.35);

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);

  z-index: 16;
}

.sound-btn:active {
  transform: scale(0.9);
}

/* ================================
   VIDEO INFO
================================ */

.video-info {
  position: absolute;

  left: 18px;
  right: 90px;
  bottom: 82px;

  z-index: 14;
}

/* Username */

.username {
  margin-bottom: 8px;

  font-size: 18px;
  font-weight: 800;

  color: #fff;

  text-shadow:
    0 2px 5px rgba(0, 0, 0, 0.8),
    0 1px 2px #000;
}

/* Caption */

.caption {
  max-width: 330px;

  margin-bottom: 9px;

  font-size: 15px;
  line-height: 1.35;

  color: #fff;

  text-shadow:
    0 2px 4px rgba(0, 0, 0, 0.8),
    0 1px 2px #000;

  word-wrap: break-word;
}

/* Sound */

.sound {
  max-width: 280px;

  font-size: 14px;

  color: #fff;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;

  text-shadow:
    0 2px 4px rgba(0, 0, 0, 0.8);
}

/* ================================
   PAUSE INDICATOR
================================ */

.pause-indicator {
  position: absolute;

  top: 50%;
  left: 50%;

  width: 65px;
  height: 65px;

  transform: translate(-50%, -50%) scale(0.8);

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(0, 0, 0, 0.55);

  font-size: 25px;

  opacity: 0;
  pointer-events: none;

  z-index: 30;

  transition: 0.2s ease;
}

.pause-indicator.show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

/* ================================
   BOTTOM NAVIGATION
================================ */

.bottom-nav {
  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  height: 76px;

  padding:
    7px
    max(8px, env(safe-area-inset-right))
    calc(7px + env(safe-area-inset-bottom))
    max(8px, env(safe-area-inset-left));

  display: flex;
  align-items: center;
  justify-content: space-around;

  background: rgba(5, 5, 5, 0.96);

  border-top: 1px solid rgba(255, 255, 255, 0.08);

  z-index: 50;

  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
}

/* ================================
   NAV BUTTON
================================ */

.nav-btn {
  width: 20%;

  height: 65px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 4px;

  color: rgba(255, 255, 255, 0.55);

  font-size: 11px;
  font-weight: 500;

  transition: 0.2s ease;
}

.nav-btn:active {
  transform: scale(0.88);
}

.nav-btn.active {
  color: #fff;
}

.nav-icon {
  width: 30px;
  height: 30px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 22px;
}

/* ================================
   UPLOAD BUTTON
================================ */

.upload-btn {
  width: 48px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  position: relative;

  color: #000;

  font-size: 22px;

  background: #fff;

  border-radius: 11px;

  box-shadow:
    -4px 0 0 #ff2d55,
    4px 0 0 #29b6f6;
}

.upload-btn i {
  font-size: 20px;
}

/* ================================
   COMMENT PANEL
================================ */

.comment-panel {
  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  height: 70vh;

  background: #111;

  border-radius: 20px 20px 0 0;

  transform: translateY(100%);

  transition: transform 0.3s ease;

  z-index: 100;

  display: flex;
  flex-direction: column;

  box-shadow:
    0 -5px 30px rgba(0, 0, 0, 0.5);
}

.comment-panel.open {
  transform: translateY(0);
}

/* ================================
   COMMENT HEADER
================================ */

.comment-header {
  height: 58px;

  padding: 0 18px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-bottom: 1px solid #2b2b2b;

  font-size: 16px;
  font-weight: 700;

  position: relative;
}

.close-comments {
  position: absolute;

  right: 18px;

  font-size: 22px;

  color: #fff;
}

/* ================================
   COMMENTS
================================ */

.comments-list {
  flex: 1;

  overflow-y: auto;

  padding: 12px 18px;
}

.comment {
  padding: 12px 0;

  border-bottom: 1px solid rgba(255, 255, 255, 0.08);

  font-size: 14px;
  line-height: 1.4;
}

.comment strong {
  display: block;

  margin-bottom: 4px;

  color: #fff;

  font-size: 14px;
}

/* ================================
   COMMENT INPUT
================================ */

.comment-input {
  display: flex;

  gap: 8px;

  padding: 10px 12px;

  background: #151515;

  border-top: 1px solid #292929;
}

.comment-input input {
  flex: 1;

  height: 44px;

  padding: 0 15px;

  border: 1px solid #333;

  outline: none;

  border-radius: 22px;

  background: #222;

  color: #fff;

  font-size: 14px;
}

.comment-input input::placeholder {
  color: #888;
}

.comment-input button {
  width: 44px;
  height: 44px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #ff2d55;

  color: #fff;

  font-size: 17px;
}

/* ================================
   TOAST
================================ */

.toast {
  position: fixed;

  left: 50%;
  bottom: 100px;

  transform: translateX(-50%) translateY(20px);

  padding: 10px 18px;

  border-radius: 20px;

  background: rgba(30, 30, 30, 0.92);

  color: #fff;

  font-size: 14px;

  opacity: 0;

  pointer-events: none;

  transition: 0.25s ease;

  z-index: 200;

  white-space: nowrap;
}

.toast.show {
  opacity: 1;

  transform: translateX(-50%) translateY(0);
}

/* ================================
   LOGIN / EMPTY MESSAGE
================================ */

.feed-message {
  width: 100%;
  height: 100dvh;

  display: flex;
  align-items: center;
  justify-content: center;

  text-align: center;

  padding: 20px;
}

.feed-message-inner {
  max-width: 320px;
}

.feed-message-icon {
  margin-bottom: 15px;

  font-size: 45px;
}

.feed-message-inner > div:not(.feed-message-icon) {
  margin-bottom: 15px;

  font-size: 16px;
}

.retry-btn {
  padding: 11px 25px;

  border-radius: 22px;

  background: #fff;

  color: #000;

  font-weight: 700;
}

/* ================================
   SMALL PHONES
================================ */

@media (max-width: 380px) {

  .top-bar {
    padding-left: 12px;
    padding-right: 12px;
  }

  .tabs {
    gap: 8px;
  }

  .tab {
    padding: 8px 11px;
    font-size: 14px;
  }

  .action-bar {
    right: 7px;
    gap: 14px;
  }

  .action-icon {
    width: 45px;
    height: 45px;
    font-size: 25px;
  }

  .video-info {
    left: 12px;
    right: 75px;
  }

  .username {
    font-size: 16px;
  }

  .caption {
    font-size: 14px;
  }
}

/* ================================
   TABLET / DESKTOP
================================ */

@media (min-width: 768px) {

  .app {
    max-width: 500px;
    margin: 0 auto;

    box-shadow:
      0 0 50px rgba(0, 0, 0, 0.8);
  }

  .bottom-nav {
    max-width: 500px;
    left: 50%;
    right: auto;

    transform: translateX(-50%);

    width: 100%;
  }
}
