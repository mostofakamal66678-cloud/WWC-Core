/* =========================================================
   WWC - MOBILE VIDEO FEED
   TikTok Style UI
   ========================================================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #000;
  color: #fff;
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif;
}

body {
  overscroll-behavior: none;
}

button,
input {
  font-family: inherit;
}

button {
  border: 0;
  outline: none;
  cursor: pointer;
  background: transparent;
  color: inherit;
  -webkit-tap-highlight-color: transparent;
}

.app {
  position: relative;
  width: 100%;
  height: 100dvh;
  overflow: hidden;
  background: #000;
}


/* =========================================================
   VIDEO FEED
   ========================================================= */

.feed {
  position: relative;

  width: 100%;
  height: 100dvh;

  overflow-y: auto;
  overflow-x: hidden;

  scroll-snap-type: y mandatory;
  scroll-behavior: smooth;

  -webkit-overflow-scrolling: touch;

  scrollbar-width: none;
}

.feed::-webkit-scrollbar {
  display: none;
}


/* =========================================================
   VIDEO ITEM
   ========================================================= */

.video-item {
  position: relative;

  width: 100%;
  height: 100dvh;
  min-height: 100dvh;

  background: #000;

  scroll-snap-align: start;
  scroll-snap-stop: always;

  overflow: hidden;
}


/* VIDEO */

.video {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  background: #000;

  display: block;
}


/* =========================================================
   DARK VIDEO GRADIENT
   ========================================================= */

.video-item::after {
  content: "";

  position: absolute;

  inset: 0;

  pointer-events: none;

  background:
    linear-gradient(
      to bottom,
      rgba(0, 0, 0, .40) 0%,
      rgba(0, 0, 0, .05) 20%,
      transparent 48%,
      rgba(0, 0, 0, .08) 65%,
      rgba(0, 0, 0, .72) 100%
    );

  z-index: 1;
}


/* =========================================================
   TOP BAR
   ========================================================= */

.top-bar {
  position: absolute;

  top: 0;
  left: 0;
  right: 0;

  height: 108px;

  padding:
    calc(18px + env(safe-area-inset-top))
    18px
    14px;

  display: flex;

  align-items: flex-end;
  justify-content: center;

  z-index: 10;

  background:
    linear-gradient(
      to bottom,
      rgba(0, 0, 0, .55),
      rgba(0, 0, 0, .12),
      transparent
    );
}


/* =========================================================
   WWC LOGO / TOP AREA
   ========================================================= */

.top-bar::before {
  content: "🌐  WWC";

  position: absolute;

  left: 20px;
  bottom: 19px;

  color: #fff;

  font-size: 22px;
  font-weight: 800;

  letter-spacing: .2px;

  text-shadow:
    0 1px 5px rgba(0, 0, 0, .5);
}


/* =========================================================
   TABS
   ========================================================= */

.tabs {
  display: flex;

  align-items: center;

  gap: 6px;

  padding: 3px;

  border-radius: 22px;

  background: rgba(255, 255, 255, .08);

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.tab {
  min-width: 82px;

  padding: 8px 13px;

  border-radius: 18px;

  color: rgba(255, 255, 255, .55);

  font-size: 15px;
  font-weight: 600;

  transition: .2s ease;
}

.tab.active {
  color: #fff;

  background: rgba(255, 255, 255, .22);

  box-shadow:
    0 3px 12px rgba(0, 0, 0, .15);
}


/* =========================================================
   SEARCH BUTTON
   ========================================================= */

.search-btn {
  position: absolute;

  right: 15px;
  bottom: 13px;

  width: 45px;
  height: 45px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  color: #fff;

  background: rgba(0, 0, 0, .38);

  border: 1px solid rgba(255, 255, 255, .35);

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);

  font-size: 20px;

  z-index: 20;

  transition: .2s ease;
}

.search-btn:active {
  transform: scale(.9);
}


/* =========================================================
   ACTION BAR
   ========================================================= */

.action-bar {
  position: absolute;

  right: 10px;
  bottom: 155px;

  width: 58px;

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 15px;

  z-index: 10;
}


/* =========================================================
   ACTION BUTTON
   ========================================================= */

.action {
  width: 55px;

  min-height: 58px;

  padding: 0;

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  gap: 3px;

  color: #fff;

  text-shadow:
    0 1px 4px rgba(0, 0, 0, .7);

  transition: transform .18s ease;
}

.action:active {
  transform: scale(.86);
}


/* =========================================================
   ACTION ICON
   ========================================================= */

.action-icon {
  width: 48px;
  height: 48px;

  display: flex;

  align-items: center;
  justify-content: center;

  font-size: 29px;

  color: #fff;

  filter:
    drop-shadow(0 2px 5px rgba(0, 0, 0, .55));
}

.action-count {
  color: #fff;

  font-size: 13px;
  font-weight: 700;

  line-height: 16px;

  text-shadow:
    0 1px 4px #000;
}


/* =========================================================
   LIKE
   ========================================================= */

.like-btn .action-icon {
  color: #fff;
}

.like-btn.liked .action-icon {
  color: #ff2d55;

  transform: scale(1.18);

  animation: heartPop .28s ease;
}

.like-btn.liked .action-count {
  color: #ff4f70;
}


/* =========================================================
   COMMENT
   ========================================================= */

.comment-btn .action-icon {
  color: #fff;
}


/* =========================================================
   SAVE
   ========================================================= */

.save-btn .action-icon {
  color: #fff;
}

.save-btn.saved .action-icon {
  color: #28aef7;

  transform: scale(1.12);
}

.save-btn.saved .action-count {
  color: #28aef7;
}


/* =========================================================
   SHARE
   ========================================================= */

.share-btn .action-icon {
  color: #fff;
}


/* =========================================================
   CREATOR AVATAR
   ========================================================= */

.creator-avatar {
  position: relative;

  width: 52px;
  height: 52px;

  border-radius: 50%;

  padding: 2px;

  background: #fff;

  box-shadow:
    0 2px 12px rgba(0, 0, 0, .45);
}

.creator-avatar img {
  width: 100%;
  height: 100%;

  display: block;

  border-radius: 50%;

  object-fit: cover;

  background: #222;
}


/* =========================================================
   FOLLOW PLUS
   ========================================================= */

.follow-plus {
  position: absolute;

  left: 50%;
  bottom: -9px;

  width: 25px;
  height: 25px;

  transform: translateX(-50%);

  border-radius: 50%;

  background: #fe2c55;

  color: #fff;

  border: 2px solid #fff;

  display: flex;

  align-items: center;
  justify-content: center;

  font-size: 17px;
  font-weight: 800;

  box-shadow:
    0 2px 8px rgba(0, 0, 0, .5);

  z-index: 5;

  transition: .2s ease;
}

.follow-plus.following {
  background: #555;
}

.follow-plus:active {
  transform: translateX(-50%) scale(.85);
}


/* =========================================================
   SOUND BUTTON
   ========================================================= */

.sound-btn {
  position: absolute;

  right: 17px;
  top: 125px;

  width: 43px;
  height: 43px;

  border-radius: 50%;

  display: flex;

  align-items: center;
  justify-content: center;

  color: #fff;

  background: rgba(0, 0, 0, .42);

  border: 1px solid rgba(255, 255, 255, .28);

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);

  font-size: 18px;

  z-index: 10;

  transition: .2s ease;
}

.sound-btn:active {
  transform: scale(.88);
}


/* =========================================================
   VIDEO INFO
   ========================================================= */

.video-info {
  position: absolute;

  left: 18px;
  right: 85px;

  bottom: 78px;

  z-index: 10;

  color: #fff;

  text-shadow:
    0 2px 6px rgba(0, 0, 0, .7);
}


/* USERNAME */

.username {
  display: inline-block;

  max-width: 100%;

  color: #fff;

  font-size: 17px;
  font-weight: 800;

  margin-bottom: 7px;

  cursor: pointer;
}


/* CAPTION */

.caption {
  max-width: 100%;

  color: #fff;

  font-size: 15px;

  line-height: 1.45;

  word-break: break-word;
}


/* SOUND */

.sound {
  margin-top: 7px;

  color: rgba(255, 255, 255, .88);

  font-size: 13px;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}


/* =========================================================
   PAUSE INDICATOR
   ========================================================= */

.pause-indicator {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 70px;
  height: 70px;

  transform:
    translate(-50%, -50%)
    scale(.8);

  border-radius: 50%;

  display: flex;

  align-items: center;
  justify-content: center;

  background: rgba(0, 0, 0, .55);

  color: #fff;

  font-size: 30px;

  opacity: 0;

  pointer-events: none;

  z-index: 20;

  transition: .2s ease;
}

.pause-indicator.show {
  opacity: 1;

  transform:
    translate(-50%, -50%)
    scale(1);
}


/* =========================================================
   VIDEO LOADER
   ========================================================= */

.video-loader {
  position: absolute;

  left: 50%;
  top: 50%;

  transform: translate(-50%, -50%);

  width: 45px;
  height: 45px;

  border-radius: 50%;

  border: 4px solid rgba(255, 255, 255, .25);

  border-top-color: #fff;

  animation: spin 1s linear infinite;

  z-index: 8;
}

.video-loader span {
  display: none;
}


/* =========================================================
   BOTTOM NAVIGATION
   ========================================================= */

.bottom-nav {
  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  height: 68px;

  padding-bottom:
    env(safe-area-inset-bottom);

  display: flex;

  align-items: center;
  justify-content: space-around;

  background: rgba(0, 0, 0, .94);

  border-top: 1px solid rgba(255, 255, 255, .06);

  z-index: 50;

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}


/* =========================================================
   NAV BUTTON
   ========================================================= */

.nav-btn {
  position: relative;

  flex: 1;

  height: 100%;

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  gap: 3px;

  color: #888;

  font-size: 11px;
  font-weight: 600;

  transition: .18s ease;
}

.nav-btn:active {
  transform: scale(.9);
}

.nav-btn.active {
  color: #fff;
}


/* NAV ICON */

.nav-icon {
  width: 30px;
  height: 30px;

  display: flex;

  align-items: center;
  justify-content: center;

  font-size: 23px;
}


/* =========================================================
   CREATE / UPLOAD BUTTON
   ========================================================= */

.upload-btn {
  width: 48px;
  height: 38px;

  margin-top: -5px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 11px;

  background: #fff;

  color: #000;

  font-size: 23px;

  box-shadow:
    0 3px 12px rgba(0, 0, 0, .5);

  position: relative;
}


/* Small colored edge */

.upload-btn::before {
  content: "";

  position: absolute;

  left: -3px;

  width: 4px;
  height: 27px;

  border-radius: 4px;

  background: #25f4ee;
}

.upload-btn::after {
  content: "";

  position: absolute;

  right: -3px;

  width: 4px;
  height: 27px;

  border-radius: 4px;

  background: #fe2c55;
}


/* =========================================================
   COMMENT PANEL
   ========================================================= */

.comment-panel {
  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  height: min(72dvh, 620px);

  background: #151515;

  border-radius: 22px 22px 0 0;

  box-shadow:
    0 -10px 35px rgba(0, 0, 0, .55);

  transform: translateY(105%);

  transition:
    transform .28s cubic-bezier(.2, .8, .2, 1);

  z-index: 100;

  display: flex;

  flex-direction: column;

  overflow: hidden;
}

.comment-panel.open {
  transform: translateY(0);
}


/* =========================================================
   COMMENT HEADER
   ========================================================= */

.comment-header {
  height: 58px;

  padding: 0 18px;

  display: flex;

  align-items: center;
  justify-content: space-between;

  color: #fff;

  font-size: 17px;
  font-weight: 800;

  border-bottom:
    1px solid rgba(255, 255, 255, .08);
}

.close-comments {
  width: 38px;
  height: 38px;

  border-radius: 50%;

  background: #292929;

  color: #fff;

  font-size: 17px;

  display: flex;

  align-items: center;
  justify-content: center;
}


/* =========================================================
   COMMENTS LIST
   ========================================================= */

.comments-list {
  flex: 1;

  overflow-y: auto;

  padding: 12px 16px;

  scrollbar-width: none;
}

.comments-list::-webkit-scrollbar {
  display: none;
}


/* COMMENT */

.comment {
  padding: 12px 4px;

  color: #eee;

  font-size: 14px;

  line-height: 1.5;

  border-bottom:
    1px solid rgba(255, 255, 255, .06);
}

.comment strong {
  display: block;

  margin-bottom: 3px;

  color: #fff;

  font-size: 14px;
}


/* =========================================================
   COMMENT INPUT
   ========================================================= */

.comment-input {
  display: flex;

  gap: 8px;

  padding:
    10px
    14px
    calc(10px + env(safe-area-inset-bottom));

  background: #101010;

  border-top:
    1px solid rgba(255, 255, 255, .08);
}

.comment-input input {
  flex: 1;

  min-width: 0;

  height: 44px;

  padding: 0 15px;

  border: 1px solid #333;

  border-radius: 22px;

  outline: none;

  background: #222;

  color: #fff;

  font-size: 14px;
}

.comment-input input::placeholder {
  color: #777;
}

.comment-input button {
  width: 44px;
  height: 44px;

  flex-shrink: 0;

  border-radius: 50%;

  background: #fe2c55;

  color: #fff;

  font-size: 16px;

  display: flex;

  align-items: center;
  justify-content: center;
}


/* =========================================================
   TOAST
   ========================================================= */

.toast {
  position: fixed;

  left: 50%;
  bottom: 95px;

  transform:
    translate(-50%, 20px);

  max-width: 85%;

  padding: 10px 18px;

  border-radius: 22px;

  background: rgba(25, 25, 25, .92);

  border: 1px solid rgba(255, 255, 255, .12);

  color: #fff;

  font-size: 13px;
  font-weight: 600;

  opacity: 0;

  pointer-events: none;

  z-index: 200;

  transition: .25s ease;

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.toast.show {
  opacity: 1;

  transform:
    translate(-50%, 0);
}


/* =========================================================
   FEED MESSAGE
   ========================================================= */

.feed-message {
  width: 100%;
  height: 100dvh;

  display: flex;

  align-items: center;
  justify-content: center;

  text-align: center;

  padding: 25px;

  background: #000;
}

.feed-message-inner {
  max-width: 320px;
}

.feed-message-icon {
  font-size: 48px;

  margin-bottom: 15px;
}

.feed-message-inner > div {
  font-size: 16px;

  color: #ddd;
}


/* =========================================================
   LOGIN / RETRY
   ========================================================= */

.retry-btn {
  margin-top: 18px;

  padding: 11px 25px;

  border-radius: 10px;

  background: #fff;

  color: #000;

  font-size: 14px;
  font-weight: 800;
}


/* =========================================================
   ANIMATIONS
   ========================================================= */

@keyframes spin {
  to {
    transform:
      translate(-50%, -50%)
      rotate(360deg);
  }
}

@keyframes heartPop {
  0% {
    transform: scale(.7);
  }

  55% {
    transform: scale(1.35);
  }

  100% {
    transform: scale(1.18);
  }
}


/* =========================================================
   SMALL PHONES
   ========================================================= */

@media (max-width: 380px) {

  .top-bar::before {
    left: 13px;

    font-size: 19px;
  }

  .tab {
    min-width: 72px;

    padding: 7px 9px;

    font-size: 13px;
  }

  .action-bar {
    right: 5px;
    bottom: 145px;

    gap: 10px;
  }

  .action {
    width: 50px;
  }

  .action-icon {
    width: 44px;
    height: 44px;

    font-size: 26px;
  }

  .action-count {
    font-size: 12px;
  }

  .video-info {
    left: 13px;
    right: 72px;

    bottom: 76px;
  }

  .username {
    font-size: 15px;
  }

  .caption {
    font-size: 14px;
  }

  .sound {
    font-size: 12px;
  }

  .upload-btn {
    width: 45px;
    height: 36px;
  }
}


/* =========================================================
   VERY SMALL SCREEN
   ========================================================= */

@media (max-height: 650px) {

  .action-bar {
    bottom: 135px;

    gap: 8px;
  }

  .action-icon {
    font-size: 25px;
  }

  .video-info {
    bottom: 72px;
  }

  .bottom-nav {
    height: 62px;
  }
}
